{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "src/**/*.js",
    "src/index.types.ts"
  ],
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": false,
    "strict": true
  }
}